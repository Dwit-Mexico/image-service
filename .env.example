# ─── Persistencia ───────────────────────────────────────────────────────────
# Postgres local: levantar con `docker compose up -d postgres`
DATABASE_URL=postgres://image_service:image_service_dev@localhost:5433/image_service

# Master key (KEK) para envelope encryption — base64 de 32 bytes random.
# Generar: openssl rand -base64 32
MASTER_KEY_V1=

# ─── Valkey (invalidación distribuida — opcional en local) ──────────────────
# Si no se define, el servicio arranca sin pub/sub (cache TTL local de 30s).
# VALKEY_SENTINEL_ADDR=valkey.data.svc.cluster.local:26379
# VALKEY_MASTER_NAME=mymaster
# VALKEY_PASSWORD=

# ─── Admin UI (opcional) ────────────────────────────────────────────────────
# Si no defines ADMIN_PASSWORD_HASH, /admin/* no se monta.
# Para generar el hash en local:
#   cargo run --example gen_admin_hash -- TUPASSWORD
# En prod se genera vía el workflow `rotate-admin-password.yml`.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$...$...'

# ─── Server ─────────────────────────────────────────────────────────────────
LISTEN_ADDR=0.0.0.0:8080
RUST_LOG=info

# ─── Legacy (solo para `seed-from-env`, no para runtime) ────────────────────
# Si vas a migrar proyectos PROJECT_* existentes a la tabla `projects`, define
# estas vars antes de correr `cargo run --bin seed-from-env`. Una vez seedeados,
# pueden eliminarse del entorno — el runtime ya no las lee.
# AZURE_STORAGE_CONNECTION_STRING=
# DEFAULT_CONTAINER=images
# PROJECT_ALPHA=project-alpha:sk_live_xxxxxxxx
# PROJECT_BETA=project-beta:sk_live_yyyyyyyy
